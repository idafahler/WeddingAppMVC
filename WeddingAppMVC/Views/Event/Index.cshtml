@model List<Event>
@{
    ViewData["Title"] = "Event";
}

<section class="section-background text-center">
    <h1 class="display-4">Alice &amp; Bob's forever begins</h1>

    @foreach(var e in Model)
    {
        <article class="text-section">
            <h2 class="text-under-title">@e.Title</h2>
            <p><strong>Starting time:</strong> @e.StartTime.ToString("h:mm tt")</p>
            @if(e.EndTime is not null)
            {
                <p><strong>Ending time:</strong> @e.EndTime.Value.ToString("h:mm tt")</p>
            }
            <p><strong>Location:</strong> @e.Location</p>
            <p><strong>Address:</strong> @e.Address</p>
            <p><strong>Description:</strong> @e.Description</p>
        </article>
    }
</section>