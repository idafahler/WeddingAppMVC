@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="section-background text-center">
    <h1>Dashboard</h1>
    <p class="text-under-title">Below you will find different sections where you can see more about the wedding - but also manage the information.</p>


    <h2>RSVP statistics</h2>
    <partial name="_GuestStatistics" model="Model.Statistics" />
</section>

<section class="section-background text-center">
    <h2>Events</h2>
    <p class="text-under-title">Click the manage button to read more, edit or delete the event.</p>
    <div class="mb-3">
        <a asp-controller="Event" asp-action="Create" class="btn btn-primary">Create event</a>
        <a asp-controller="Event" asp-action="Index" class="btn btn-outline-secondary">View event page</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Starting time</th>
                <th class="d-none d-md-table-cell">Ending time</th>
                <th class="d-none d-md-table-cell">Location</th>
                <th>Options</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Events.Any())
            {
                <tr><td colspan="5">No events yet.</td></tr>
            }
            @foreach (var e in Model.Events)
            {
                <tr>
                    <td>@e.Title</td>
                    <td>@e.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="d-none d-md-table-cell">@(e.EndTime?.ToString("HH:mm") ?? "-")</td>
                    <td class="d-none d-md-table-cell">@e.Location</td>
                    <td class="text-nowrap">
                        <div class="dropdown d-inline-block">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Manage
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Event" asp-action="Edit" asp-route-id="@e.Id">Edit</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Event" asp-action="Delete" asp-route-id="@e.Id">Delete</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

<section class="section-background text-center">
    <h2>Wedding information</h2>
    <button class="btn btn-outline-secondary mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#weddingInfoForm">
        Edit wedding information
    </button>
    <div class="collapse @(ViewData.ModelState.IsValid ? "" : "show") text-start" id="weddingInfoForm">
        <form asp-action="UpdateWeddingInfo" method="post" class="mb-4">
            <div class="mb-3">
                <label asp-for="WeddingInfo.Title" class="form-label"></label>
                <input asp-for="WeddingInfo.Title" class="form-control" />
                <span asp-validation-for="WeddingInfo.Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="WeddingInfo.WelcomeMessage" class="form-label"></label>
                <textarea asp-for="WeddingInfo.WelcomeMessage" class="form-control" rows="3"></textarea>
                <span asp-validation-for="WeddingInfo.WelcomeMessage" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="WeddingInfo.Description" class="form-label"></label>
                <textarea asp-for="WeddingInfo.Description" class="form-control" rows="6"></textarea>
                <span asp-validation-for="WeddingInfo.Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="WeddingInfo.Contact" class="form-label"></label>
                <textarea asp-for="WeddingInfo.Contact" class="form-control" rows="3"></textarea>
                <span asp-validation-for="WeddingInfo.Contact" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="WeddingInfo.WebsiteDescription" class="form-label"></label>
                <textarea asp-for="WeddingInfo.WebsiteDescription" class="form-control" rows="4"></textarea>
                <span asp-validation-for="WeddingInfo.WebsiteDescription" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="WeddingInfo.ClosingMessage" class="form-label"></label>
                <textarea asp-for="WeddingInfo.ClosingMessage" class="form-control" rows="2"></textarea>
                <span asp-validation-for="WeddingInfo.ClosingMessage" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</section>