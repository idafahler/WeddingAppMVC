@model GuestListViewModel
@{
    ViewData["Title"] = "List guests";
}

<section class="section-background text-center">
    <h1>All guests</h1>
    <p class="text-under-title">On this page you will find statistics about answering guests, but also manage the registered guests.</p>
    <p class="text-under-title">Registering a <strong>new guest</strong> is done on another page. <a class="link-in-text" asp-controller="Guest" asp-action="Create">Click here</a></p>

    <h2>RSVP statistics</h2>
    <partial name="_GuestStatistics" model="Model.Statistics" />

    <h2>List of all registered guests</h2>

    <form method="get" asp-action="Index" class="row g-2 justify-content-center mb-3">
        <div class="col-auto">
            <div class="input-group">
                <input asp-for="Search" type="search" class="form-control" placeholder="Search name" aria-label="Search guests" />
                <button type="submit" class="btn btn-outline-secondary">Search</button>
            </div>
        </div>
        <div class="col-auto">
            <select asp-for="Filter" class="form-select" onchange="this.form.submit()"> @*Do not need to click a button, results are updated when user changes options in menu*@
                <option value="">All guests</option>
                <option value="attending">Attending</option>
                <option value="notattending">Not attending</option>
                <option value="notanswered">Not answered</option>
            </select>
        </div>
        <div class="col-auto">
            <select asp-for="SortBy" class="form-select" onchange="this.form.submit()">
                <option value="">Name (A-Z)</option>
                <option value="name_desc">Name (Z-A)</option>
                <option value="status">RSVP status</option>
                <option value="status_desc">RSVP status (reversed)</option>
                <option value="date">Registration date (oldest)</option>
                <option value="date_desc">Registration date (newest)</option>
            </select>
        </div>
    </form>

    <p class="text-under-title d-lg-none">Some columns are hidden on smaller screens. Open the guest details to see all available information about the guest.</p>

    <table class="table table-striped table-hover guest-table table-responsive">
        <thead>
            <tr>
                <th>Name</th>
                <th class="d-none d-md-table-cell">Email</th>
                <th>Phone</th>
                <th>Attending</th>
                <th class="d-none d-md-table-cell">Number of attendants</th>
                <th class="message-col d-none d-lg-table-cell">Message</th>
                <th class="d-none d-lg-table-cell">Registration date</th>
                <th>Options</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Guests.Any())
            {
                <tr><td colspan="8">No guests match your search.</td></tr>
            }
            @foreach(var guest in Model.Guests)
            {
                <tr>
                    <td><a asp-controller="Guest" asp-action="Details" asp-route-id=@guest.Id class="link-in-text">@guest.FullName</a></td>
                    <td class="d-none d-md-table-cell">@guest.Email</td>
                    <td>@guest.PhoneNumber</td>

                    @if (!guest.HasResponded)
                    {
                        <td>No response</td>
                        <td class="d-none d-md-table-cell">0</td>
                    }
                    else
                    {
                        <td>@(guest.Attendance ? "Yes" : "No")</td>
                        <td class="d-none d-md-table-cell">@(guest.Attendance ? guest.NumberOfAttendants : 0)</td>
                    }

                    <td class="d-none d-lg-table-cell">@guest.Message</td>
                    <td class="d-none d-lg-table-cell">@guest.RegistrationDate.ToString("yyyy-MM-dd HH:mm")</td>

                    <!--Dropdown menu for managing guest-->
                    <td class="text-nowrap">
                        <div class="dropdown d-inline-block">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Manage
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (!guest.HasResponded)
                                {
                                    <li><a class="dropdown-item" asp-controller="Guest" asp-action="Rsvp" asp-route-id="@guest.Id">Rsvp</a></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Guest" asp-action="Details" asp-route-id="@guest.Id">Details</a></li>
                                <li><a class="dropdown-item" asp-controller="Guest" asp-action="Edit" asp-route-id="@guest.Id">Edit</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Guest" asp-action="Delete" asp-route-id="@guest.Id">Delete</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>