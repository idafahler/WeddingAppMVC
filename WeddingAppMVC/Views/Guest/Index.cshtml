@model List<Guest>
@{
    ViewData["Title"] = "List guests";
}

<section class="section-background text-center">
    <h1>All guests</h1>

    <table class="table table-striped table-hover guest-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Attending</th>
                <th>Number of attendants</th>
                <th class="message-col">Message</th>
                <th>Registration date</th>
                <th>Handle guest</th>
            </tr>
        </thead>
    <tbody>
            @foreach(var guest in Model)
            {
                <tr>
                    <td><a asp-controller="Guest" asp-action="Details" asp-route-id=@guest.Id>@guest.FullName</a></td>
                    <td>@guest.Email</td>
                    <td>@guest.PhoneNumber</td>
                    <td>@(guest.Attendance ? "Yes" : "No")
                    </td>
                    <td>@guest.NumberOfAttendants</td>
                    <td>@guest.Message</td>
                    <td>@guest.RegistrationDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-nowrap">
                        <div class="dropdown d-inline-block">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Manage
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (!guest.HasResponded)
                                {
                                    <li><a class="dropdown-item" asp-controller="Guest" asp-action="Rsvp" asp-route-id="@guest.Id">Rsvp</a></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Guest" asp-action="Details" asp-route-id="@guest.Id">Details</a></li>
                                <li><a class="dropdown-item" asp-controller="Guest" asp-action="Edit" asp-route-id="@guest.Id">Edit</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Guest" asp-action="Delete" asp-route-id="@guest.Id">Delete</a></li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>