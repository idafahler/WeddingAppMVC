@model Guest

@{
    ViewData["Title"] = "Edit guest";
}

<section class="section-background container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <h1 class="text-center">Edit guest - @Model.FullName</h1>
            <p class="text-under-title text-center">Please edit the values down below.</p>

            <form method="post">

                <!--First name-->
                <div class="mb-3">
                    <label asp-for="@Model.FirstName" class="form-label"></label>
                    <input asp-for="@Model.FirstName" class="form-control" />
                    <span asp-validation-for="@Model.FirstName" class="text-danger"></span>
                </div>

                <!--Last name-->
                <div class="mb-3">
                    <label asp-for="@Model.LastName" class="form-label"></label>
                    <input asp-for="@Model.LastName" class="form-control" />
                    <span asp-validation-for="@Model.LastName" class="text-danger"></span>
                </div>

                <!--Email-->
                <div class="mb-3">
                    <label asp-for="@Model.Email" class="form-label"></label>
                    <input asp-for="@Model.Email" class="form-control" type="email" />
                    <span asp-validation-for="@Model.Email" class="text-danger"></span>
                </div>

                <!--Phone number-->
                <div class="mb-3">
                    <label asp-for="@Model.PhoneNumber" class="form-label"></label>
                    <input asp-for="@Model.PhoneNumber" class="form-control" type="tel" />
                    <span asp-validation-for="@Model.PhoneNumber" class="text-danger"></span>
                </div>

                @if (Model.HasResponded)
                    {
                        <!--Attendance-->
                        <div class="mb-3">
                            <input asp-for="@Model.Attendance" class="form-check-input" />
                            <label asp-for="@Model.Attendance" class="form-check-label"></label>
                            <span asp-validation-for="@Model.Attendance" class="text-danger"></span>
                        </div>

                        <!--Number of attendants-->
                        <div class="mb-3">
                            <label asp-for="@Model.NumberOfAttendants" class="form-label"></label>
                            <input asp-for="@Model.NumberOfAttendants" class="form-control" type="number" min="1" max="10" />
                            <span asp-validation-for="@Model.NumberOfAttendants" class="text-danger"></span>
                        </div>

                        <!--Message-->
                        <div class="mb-3">
                            <label asp-for="@Model.Message" class="form-label"></label>
                            <textarea asp-for="@Model.Message" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="@Model.Message" class="text-danger"></span>
                        </div>
                    }

                <button type="submit" class="btn form-button">Edit guest</button>

            </form>

        </div>
    </div>
</section>
